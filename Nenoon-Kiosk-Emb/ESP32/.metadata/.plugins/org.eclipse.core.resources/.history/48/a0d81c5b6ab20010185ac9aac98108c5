#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/queue.h"
#include "freertos/timers.h"
#include "freertos/semphr.h"
#include "esp_log.h"

static const char* TAG = "app";

/* ===== 공용 IPC ===== */
static QueueHandle_t g_msgq;          // 생산자→소비자 큐
static SemaphoreHandle_t g_log_lock;  // printf 보호(선택)
static TimerHandle_t g_1s_timer;      // 1초 주기 소프트웨어 타이머

/* ===== 안전 printf 래퍼(선택) ===== */
static void safe_printf(const char* fmt, ...)
{
    if (g_log_lock) xSemaphoreTake(g_log_lock, portMAX_DELAY);
    va_list ap; va_start(ap, fmt);
    vprintf(fmt, ap);
    va_end(ap);
    if (g_log_lock) xSemaphoreGive(g_log_lock);
}

/* ===== 타이머 콜백: 1초마다 큐에 메시지 투입 ===== */
static void one_sec_timer_cb(TimerHandle_t xTimer)
{
    static uint32_t tick = 0;
    tick++;
    uint32_t val = tick;
    BaseType_t hpw = pdFALSE;
    xQueueSendFromISR(g_msgq, &val, &hpw);   // 소프트 타이머는 태스크 컨텍스트지만, hpw 패턴은 안전
    if (hpw) portYIELD_FROM_ISR();           // 형식상(실제 소프트타이머에선 필요 없음)
}

/* ===== 생산자 태스크: 주기적으로 메시지 생성 ===== */
static void ProducerTask(void* arg)
{
    for (;;)
    {
        uint32_t v = (uint32_t)xTaskGetTickCount();
        xQueueSend(g_msgq, &v, portMAX_DELAY);
        vTaskDelay(pdMS_TO_TICKS(500)); // 0.5초
    }
}

/* ===== 소비자 태스크: 큐 수신 후 처리 ===== */
static void ConsumerTask(void* arg)
{
    uint32_t v;
    for (;;)
    {
        if (xQueueReceive(g_msgq, &v, portMAX_DELAY) == pdPASS)
        {
            safe_printf("[Consumer] got %u (tick=%u)\n", v, (unsigned)xTaskGetTickCount());
        }
    }
}

/* ===== 메인 진입점 ===== */
void app_main(void)
{
    ESP_LOGI(TAG, "FreeRTOS skeleton start");

    /* 뮤텍스/큐/타이머 생성 */
    g_log_lock = xSemaphoreCreateMutex();
    configASSERT(g_log_lock != NULL);

    g_msgq = xQueueCreate(16, sizeof(uint32_t));
    configASSERT(g_msgq != NULL);

    g_1s_timer = xTimerCreate("t1s", pdMS_TO_TICKS(1000), pdTRUE, NULL, one_sec_timer_cb);
    configASSERT(g_1s_timer != NULL);
    xTimerStart(g_1s_timer, 0);

    /* 태스크 생성 */
    xTaskCreatePinnedToCore(ProducerTask, "prod", 2048, NULL, 5, NULL, tskNO_AFFINITY);
    xTaskCreatePinnedToCore(ConsumerTask, "cons", 2048, NULL, 5, NULL, tskNO_AFFINITY);

    /* 여기서 app_main은 반환해도 되고, 그대로 놔둬도 OK */
}
