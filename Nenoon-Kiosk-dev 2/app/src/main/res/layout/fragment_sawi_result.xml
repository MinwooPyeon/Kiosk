<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="근거리 사위 검사 결과"
            android:textSize="40sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이상 없을 경우 아래와 같은 결과가 나옵니다."
            android:textSize="24sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="32dp"/>

        <!-- Normal Case Example Layout -->
        <LinearLayout
            android:id="@+id/normal_case_layout"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_normal_left_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수평 사위"
                        android:textSize="20sp"
                        android:textColor="@android:color/black"/>

                    <TextView
                        android:id="@+id/tv_normal_left_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="정상"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/neNoon_blue"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tv_normal_left_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수평 사위가 없습니다."
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_normal_right_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수직 사위"
                        android:textSize="20sp"
                        android:textColor="@android:color/black"/>

                    <TextView
                        android:id="@+id/tv_normal_right_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="정상"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/neNoon_blue"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tv_normal_right_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수직 사위가 없습니다."
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- User's Result Layout -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 결과"
            android:textSize="32sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_left_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="왼쪽 눈"
                        android:textSize="20sp"
                        android:textColor="@android:color/black"/>

                    <TextView
                        android:id="@+id/tv_horizontal_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="결과"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/neNoon_blue"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tv_horizontal_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="설명"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:layout_margin="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_right_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오른쪽 눈"
                        android:textSize="20sp"
                        android:textColor="@android:color/black"/>

                    <TextView
                        android:id="@+id/tv_vertical_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="결과"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/neNoon_blue"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tv_vertical_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="설명"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="모든 눈 검사는 자가 검사로 의학적 소견이 아니기에 정확한 판단과 진단은 병원을 방문하여 의사와 상담하시길 바랍니다. 내 눈의 상태와 주변 환경 또는 기기에 따라 검사 결과가 달라질 수 있습니다."
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:alpha="0.8"
            android:layout_marginTop="24dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btn_print_result"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:text="결과 프린트하기"
            android:textSize="32sp"
            android:background="@drawable/btn_background_white"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:drawablePadding="12dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_back_to_main"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:text="메인 메뉴로 돌아가기"
            android:textSize="32sp"
            android:background="@drawable/btn_background_white"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:drawablePadding="12dp"/>

    </LinearLayout>
</ScrollView>