<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@android:color/black"
android:padding="24dp">

<include layout="@layout/header_layout" android:id="@+id/header"/>

<TextView
    android:id="@+id/tv_instruction_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="평소에 안경을 착용하신다면 "
    android:textColor="@android:color/white"
    android:textSize="30sp"
    android:layout_centerHorizontal="true"
    android:layout_below="@id/header"
    android:layout_marginTop="50dp"
    android:layout_marginBottom="5dp"/>

    <TextView
        android:id="@+id/tv_instruction_text_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="안경을 착용 후 검사를 진행해주세요."
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_instruction_text"
        android:layout_marginBottom="50dp"/>

<ImageView
    android:id="@+id/iv_glass_image"
    android:layout_width="1000dp"
    android:layout_height="1100dp"
    android:src="@drawable/glassimage"
    android:layout_below="@id/tv_instruction_text_1"
    android:layout_centerInParent="true"
    android:layout_marginBottom="120dp"/>

<Button
    android:id="@+id/btn_next"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:text="다음"
    android:background="@drawable/rounded_button_blue"
    android:textColor="@android:color/white"
    android:layout_alignParentBottom="true"
    android:elevation="0dp"
    android:textSize="32sp"/>


</RelativeLayout>
