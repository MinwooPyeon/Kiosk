
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_back_to_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textSize="48sp"
        android:textColor="@android:color/black"
        android:background="@android:color/transparent"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tv_fudo_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="부동상시 검사"
        android:textSize="70sp"
        android:textColor="@android:color/black"
        android:layout_alignParentStart="true"
        android:layout_below="@id/btn_back_to_main"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="양쪽 눈의 망막상 크기 차이를 확인하는 검사입니다."
        android:textSize="26sp"
        android:textColor="@android:color/darker_gray"
        android:gravity="start"
        android:layout_below="@id/tv_fudo_title"
        android:layout_marginTop="80px"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

    <Button
        android:id="@+id/btn_fudo_how_to"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:text="검사 방법 보기"
        android:background="@drawable/rounded_button_light"
        android:textColor="@color/neNoon_blue"
        android:layout_above="@+id/btn_fudo_start"
        android:layout_marginBottom="16dp"
        android:elevation="0dp"
        android:textSize="32sp"/>

    <Button
        android:id="@+id/btn_fudo_start"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:text="검사 시작"
        android:background="@drawable/rounded_button_blue"
        android:textColor="@android:color/white"
        android:layout_alignParentBottom="true"
        android:elevation="0dp"
        android:textSize="32sp"/>

</RelativeLayout>
