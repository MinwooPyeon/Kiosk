## This file is an example of local.properties
## Copy this file to 'local.properties' and configure it for your environment
## NOTE: local.properties should NOT be committed to version control
##
## To use this file:
##   cp local.properties.example local.properties
##   (Then edit local.properties with your configuration)

# Location of the Android SDK
# This will be auto-generated by Android Studio, but you can set it manually
sdk.dir=/path/to/your/android/sdk

# Admin password for the kiosk application
# This is the default password used when no password is set in SharedPreferences
# Change this to your desired default admin password (default: 0000)
admin.password=0000